+#ifdef HAVE_XTEST
+// Serialize allocation/recovery across screen servers sharing one X keyboard.
+class KeyboardMap {
+public:
+  explicit KeyboardMap(Display* display) : dpy(display) {
+    XGrabServer(dpy);
+    map = XkbGetMap(dpy, XkbAllComponentsMask, XkbUseCoreKbd);
+  }
+  ~KeyboardMap() {
+    if (map)
+      XkbFreeKeyboard(map, XkbAllComponentsMask, True);
+    XUngrabServer(dpy);
+    XFlush(dpy);
+  }
+  XkbDescPtr map;
+private:
+  Display* dpy;
+};
+
+static Atom keymapAtom(Display* dpy, unsigned int key) {
+  char name[64];
+  snprintf(name, sizeof(name), "_TIGERVNC_KEYCODE_V1_%u", key);
+  return XInternAtom(dpy, name, False);
+}
+#endif
