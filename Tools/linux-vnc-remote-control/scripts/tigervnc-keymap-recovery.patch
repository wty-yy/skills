+KeyCode XDesktop::getOrphanedKeycode(XkbDescPtr xkb)
+{
+  char pressed[32];
+  XQueryKeymap(dpy, pressed);
+  for (unsigned int key = xkb->min_key_code; key <= xkb->max_key_code; key++) {
+    if ((pressed[key / 8] & (1 << (key % 8))) ||
+        XkbKeyNumGroups(xkb, key) != 1)
+      continue;
+
+    Atom atom = keymapAtom(dpy, key);
+    // Selection ownership disappears automatically when its X client dies.
+    if (XGetSelectionOwner(dpy, atom) != None)
+      continue;
+
+    Atom type;
+    int format;
+    unsigned long count, remaining;
+    unsigned char* data = nullptr;
+    int status = XGetWindowProperty(dpy, DefaultRootWindow(dpy), atom,
+                                   0, 6, False, XA_CARDINAL,
+                                   &type, &format, &count, &remaining, &data);
+    bool matches = false;
+    if (status == Success && type == XA_CARDINAL &&
+        format == 32 && remaining == 0 && count == 6) {
+      const unsigned long* saved = reinterpret_cast<unsigned long*>(data);
+      for (int i = 0; !matches && i < 6; i += 3) {
+        int width = saved[i + 2] == NoSymbol ? 1 : 2;
+        matches = saved[i + 1] != NoSymbol &&
+                  saved[i] == XkbKeyKeyTypeIndex(xkb, key, 0) &&
+                  width == XkbKeyNumSyms(xkb, key) &&
+                  saved[i + 1] == XkbKeySymsPtr(xkb, key)[0];
+        if (matches && width == 2)
+          matches = saved[i + 2] == XkbKeySymsPtr(xkb, key)[1];
+      }
+    }
+    if (data)
+      XFree(data);
+    if (matches) {
+      vlog.info("Recovering orphaned keycode %u", key);
+      return key;
+    }
+  }
+  return 0;
+}
