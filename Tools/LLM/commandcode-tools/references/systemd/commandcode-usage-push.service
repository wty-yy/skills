[Unit]
Description=Publish Command Code usage report to Cloudflare KV

[Service]
Type=oneshot
# Adjust WorkingDirectory to the directory that holds commandcode_usage.py and usage_report.py
WorkingDirectory=%h/Documents/ai_search/commandcode_usage
EnvironmentFile=%h/.config/commandcode-usage/env
ExecStart=%h/.local/bin/uv run usage_report.py --push
TimeoutStartSec=600
